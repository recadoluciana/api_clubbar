# Identificação do ambiente: development ou production
APP_ENV=development

# Banco específico deste ambiente
DATABASE_URL=mysql://usuario:senha@host:3306/banco

# URL pública da API deste mesmo ambiente, sem barra final
PUBLIC_API_BASE_URL=https://apiclubbar-desenvolvimento.up.railway.app
PUBLIC_CLIENT_BASE_URL=https://clubbarcliente-desenvolvimento.up.railway.app

# Desenvolvimento deve usar Sandbox; produção deve usar a API de produção
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Opcional enquanto as contas forem abertas manualmente. Será usada no onboarding automático futuro.
ASAAS_PARENT_API_KEY=substitua-pela-chave-da-conta-pai-do-ambiente
ASAAS_CLUBBAR_WALLET_ID=substitua-pela-wallet-da-conta-clubbar
ASAAS_CREDENTIAL_ENCRYPTION_KEY=substitua-por-uma-chave-fernet

# Token de 32 a 255 caracteres configurado no webhook Asaas deste ambiente
# Cada loja possui seu próprio token, cadastrado pelo endpoint /lojas/{loja_id}/asaas.
